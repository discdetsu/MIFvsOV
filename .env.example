# Copy to .env and uncomment what you want to change. Values shown are the defaults.
# `docker compose up` loads .env into the app container. For a local `uv run uvicorn ...`,
# export the variables in your shell instead (the app reads the environment, not this file).

# --- Model ---
# Inference runtime: torch (default) or onnx.
# MIFVSOV_RUNTIME=torch
# MIFVSOV_WEIGHTS_PATH=weights/best.pt
# MIFVSOV_ONNX_PATH=weights/best.onnx
# Letterbox size the model was trained at.
# MIFVSOV_IMG_SIZE=640
# torch.set_num_threads / onnxruntime intra-op threads. Unset = library default. Use 1 on small hosts.
# MIFVSOV_NUM_THREADS=1

# --- Detection ---
# Server-side confidence floor; the API returns everything at or above it.
# MIFVSOV_DETECT_CONF=0.10
# Default position of the client's confidence slider.
# MIFVSOV_CONF=0.25
# Non-maximum suppression IoU threshold and max boxes per image.
# MIFVSOV_IOU=0.45
# MIFVSOV_MAX_DET=300

# --- Server ---
# Upload limit in MB.
# MIFVSOV_MAX_UPLOAD_MB=5
# JSON list of allowed origins; only needed when the frontend is served from another origin.
# MIFVSOV_CORS_ORIGINS=["http://localhost:5173"]
# Built SPA to serve at /. Skipped if the directory doesn't exist.
# MIFVSOV_STATIC_DIR=static
# Port uvicorn listens on in the Docker image (Render and similar hosts set this themselves).
# PORT=8000
